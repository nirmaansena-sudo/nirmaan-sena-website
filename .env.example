# ─── Site ────────────────────────────────────────────────
# Public URL of the website (used for SEO, sitemap and share previews)
NEXT_PUBLIC_SITE_URL=https://nirmaansena.com

# ─── Admin dashboard login ───────────────────────────────
ADMIN_EMAIL=admin@nirmaansena.com
# At least 12 characters on the live site. Changing it signs everyone out.
ADMIN_PASSWORD=change-this-to-a-long-password
# Random string, at least 32 characters. Signs the login cookie.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# ─── Database (MongoDB Atlas) ────────────────────────────
# Leave empty to use the built-in file store (local development only).
MONGODB_URI=
MONGODB_DB=nirmaansena

# ─── Photo & video uploads (Cloudinary) ──────────────────
# Leave empty to store uploads on this computer (local development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nirmaan-sena

# ─── Optional: forward website enquiries ─────────────────
# Your Nirmaan Sena automation system endpoint, e.g.
# https://ops.nirmaansena.com/api/public/website-enquiry
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
